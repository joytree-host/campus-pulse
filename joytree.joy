name: campus-pulse

# Converted from render.yaml (Render Blueprint) to Joytree's own Blueprint
# format. Same two services + one database render.yaml declared, translated
# field-for-field, with two intentional differences from the Render version:
#
#   1. No PORT env var. Joytree assigns and injects its own PORT into every
#      service container (anything named PORT/HOST/HOSTNAME set here would
#      be silently stripped at deploy time), and server/src/index.js already
#      falls back to 4000 when PORT isn't set, so nothing to change there.
#
#   2. CORS_ORIGIN is declared below with `sync: false`, same as
#      render.yaml's own CORS_ORIGIN entry -- it needs a value Joytree can't
#      know at blueprint-parse time (the "web" service's own live URL, which
#      only exists once "web" has actually deployed), so it shows up as a
#      field to fill in on the Blueprint review screen instead of a literal
#      value here, exactly like Render's "Specified configurations" step.
#      First run: leave it blank on the review screen (or put anything --
#      "api" deploys before "web" exists yet, so CORS will legitimately
#      reject "web"'s origin until this is fixed). After the Blueprint
#      finishes, copy "web"'s live URL, set it as CORS_ORIGIN on the "api"
#      service (Project -> Environment Variables), then redeploy just "api".
#
# DB ordering: the database is linked after services provision, so "api"'s
# build must not need DATABASE_URL. Build only runs `prisma generate`; the
# schema push and seed now run at start (npm start), when DATABASE_URL exists.
# No failed first deploy anymore -- just set CORS_ORIGIN after "web" is live
# and redeploy "api".

services:
  - name: api
    type: web
    runtime: node
    workingDir: server
    buildCmd: npm install && npm run build
    startCmd: npm start
    env:
      STATUS_TARGETS: ""       # e.g. "Student Portal|https://portal.example.edu,LMS|https://lms.example.edu"
      STATUS_INTERVAL_MS: "30000"
      CORS_ORIGIN: { sync: false }   # fill in on the review screen -- see note above

  - name: web
    type: static
    workingDir: client
    buildCmd: npm install --include=dev && npm run build
    outputDir: dist
    env:
      VITE_API_URL: ${services.api.url}
      VITE_SOCKET_URL: ${services.api.url}

databases:
  - name: maindb
    engine: postgres
    linkTo: [api]
