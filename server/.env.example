# Database (SQLite by default; swap for a Postgres URL in production)
DATABASE_URL="file:./dev.db"

# Server
PORT=4000
CORS_ORIGIN="http://localhost:5173"

# Comma-separated list of NAME|URL pairs to probe for the status dashboard
STATUS_TARGETS="Student Portal|https://portal.example.edu,LMS|https://lms.example.edu,Library Login|https://library.example.edu"

# How often to probe, in milliseconds
STATUS_INTERVAL_MS=30000
